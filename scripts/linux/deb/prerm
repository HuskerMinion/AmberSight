#!/bin/sh
# AmberSight .deb: stop and disable the service when the package is removed
# (on an upgrade postinst restarts it instead).
set -e
if [ "$1" = remove ]; then
  if [ -d /run/systemd/system ]; then
    systemctl stop ambersight.service || true
  fi
  if command -v systemctl >/dev/null 2>&1; then
    systemctl disable ambersight.service || true
  fi
fi
exit 0
